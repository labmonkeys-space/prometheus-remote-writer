<?xml version="1.0" encoding="UTF-8"?>
<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:cm="http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.3.0"
           xsi:schemaLocation="
             http://www.osgi.org/xmlns/blueprint/v1.0.0
               https://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd
             http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.3.0
               http://aries.apache.org/schemas/blueprint-cm/blueprint-cm-1.3.0.xsd">

    <!--
        Configuration binding. ConfigAdmin PID matches the properties file at
        etc/org.opennms.plugins.tss.prometheusremotewriter.cfg so that Karaf
        picks up changes on file save and hot-reloads the plugin config.
        The PID / filename is deliberately dashless — Felix fileinstall
        parses "<prefix>-<instance>.cfg" as a factory-PID config.
    -->
    <cm:property-placeholder persistent-id="org.opennms.plugins.tss.prometheusremotewriter"
                             update-strategy="reload">
        <cm:default-properties>
            <!-- Endpoint -->
            <cm:property name="write.url" value=""/>
            <cm:property name="read.url"  value=""/>
            <!-- Source identity -->
            <cm:property name="instance.id" value=""/>
            <cm:property name="job.name"    value=""/>
            <!-- Auth -->
            <cm:property name="auth.basic.username" value=""/>
            <cm:property name="auth.basic.password" value=""/>
            <cm:property name="auth.bearer.token"   value=""/>
            <cm:property name="tenant.org-id"       value=""/>
            <!-- TLS -->
            <cm:property name="tls.ca-file"               value=""/>
            <cm:property name="tls.insecure-skip-verify"  value="false"/>
            <!-- Write pipeline -->
            <cm:property name="queue.capacity"            value="10000"/>
            <cm:property name="batch.size"                value="1000"/>
            <cm:property name="flush.interval-ms"         value="1000"/>
            <cm:property name="retry.max-attempts"        value="5"/>
            <cm:property name="retry.initial-backoff-ms"  value="250"/>
            <cm:property name="retry.max-backoff-ms"      value="10000"/>
            <!-- HTTP -->
            <cm:property name="http.connect-timeout-ms"   value="5000"/>
            <cm:property name="http.read-timeout-ms"      value="30000"/>
            <cm:property name="http.write-timeout-ms"     value="30000"/>
            <cm:property name="http.max-connections"      value="16"/>
            <!-- Shutdown -->
            <cm:property name="shutdown.grace-period-ms"  value="10000"/>

            <cm:property name="writer.shards"             value="1"/>
            <!-- Read path -->
            <cm:property name="max-series-lookback-seconds" value="7776000"/>
            <cm:property name="read.discovery-strategy"     value="single-pass"/>
            <cm:property name="read.discovery-batch-size"   value="50"/>
            <!-- Label policy -->
            <cm:property name="labels.include" value=""/>
            <cm:property name="labels.exclude" value=""/>
            <cm:property name="labels.rename"  value=""/>
            <cm:property name="labels.copy"    value=""/>
            <cm:property name="labels.if-speed-mode" value="normalized"/>
            <cm:property name="labels.categories-mode" value="per-category"/>
            <cm:property name="labels.profile"      value="native"/>
            <cm:property name="labels.attr-mode"    value="off"/>
            <cm:property name="labels.attr-include" value=""/>
            <cm:property name="metric.prefix"  value=""/>
            <!-- Metadata passthrough -->
            <cm:property name="metadata.enabled"       value="false"/>
            <cm:property name="metadata.include"       value=""/>
            <cm:property name="metadata.exclude"       value=""/>
            <cm:property name="metadata.label-prefix"  value="onms_meta_"/>
            <cm:property name="metadata.case"          value="preserve"/>
            <!-- Wire format -->
            <cm:property name="wire.protocol-version"  value="1"/>
            <!-- Write-Ahead Log -->
            <cm:property name="wal.enabled"            value="false"/>
            <cm:property name="wal.path"               value=""/>
            <cm:property name="wal.max-size-bytes"     value="536870912"/>
            <cm:property name="wal.segment-size-bytes" value="67108864"/>
            <cm:property name="wal.fsync"              value="batch"/>
            <cm:property name="wal.overflow"           value="backpressure"/>
        </cm:default-properties>
    </cm:property-placeholder>

    <!--
        Configuration holder. Reads every placeholder above and exposes an
        immutable PrometheusRemoteWriterConfig to downstream beans.
    -->
    <bean id="config"
          class="org.opennms.plugins.prometheus.remotewriter.config.PrometheusRemoteWriterConfig">
        <property name="writeUrl"                value="${write.url}"/>
        <property name="readUrl"                 value="${read.url}"/>
        <property name="instanceId"              value="${instance.id}"/>
        <property name="jobName"                 value="${job.name}"/>
        <property name="basicUsername"           value="${auth.basic.username}"/>
        <property name="basicPassword"           value="${auth.basic.password}"/>
        <property name="bearerToken"             value="${auth.bearer.token}"/>
        <property name="tenantOrgId"             value="${tenant.org-id}"/>
        <property name="tlsCaFile"               value="${tls.ca-file}"/>
        <property name="tlsInsecureSkipVerify"   value="${tls.insecure-skip-verify}"/>
        <property name="queueCapacity"           value="${queue.capacity}"/>
        <property name="batchSize"               value="${batch.size}"/>
        <property name="flushIntervalMs"         value="${flush.interval-ms}"/>
        <property name="retryMaxAttempts"        value="${retry.max-attempts}"/>
        <property name="retryInitialBackoffMs"   value="${retry.initial-backoff-ms}"/>
        <property name="retryMaxBackoffMs"       value="${retry.max-backoff-ms}"/>
        <property name="httpConnectTimeoutMs"    value="${http.connect-timeout-ms}"/>
        <property name="httpReadTimeoutMs"       value="${http.read-timeout-ms}"/>
        <property name="httpWriteTimeoutMs"      value="${http.write-timeout-ms}"/>
        <property name="httpMaxConnections"      value="${http.max-connections}"/>
        <property name="shutdownGracePeriodMs"    value="${shutdown.grace-period-ms}"/>
        <property name="writerShards"             value="${writer.shards}"/>
        <property name="maxSeriesLookbackSeconds" value="${max-series-lookback-seconds}"/>
        <property name="discoveryStrategy"       value="${read.discovery-strategy}"/>
        <property name="discoveryBatchSize"      value="${read.discovery-batch-size}"/>
        <property name="labelsInclude"           value="${labels.include}"/>
        <property name="labelsExclude"           value="${labels.exclude}"/>
        <property name="labelsRename"            value="${labels.rename}"/>
        <property name="labelsCopy"              value="${labels.copy}"/>
        <property name="ifSpeedMode"             value="${labels.if-speed-mode}"/>
        <property name="categoriesMode"          value="${labels.categories-mode}"/>
        <property name="labelProfile"            value="${labels.profile}"/>
        <property name="attrMode"                value="${labels.attr-mode}"/>
        <property name="labelsAttrInclude"       value="${labels.attr-include}"/>
        <property name="metricPrefix"            value="${metric.prefix}"/>
        <property name="metadataEnabled"         value="${metadata.enabled}"/>
        <property name="metadataInclude"         value="${metadata.include}"/>
        <property name="metadataExclude"         value="${metadata.exclude}"/>
        <property name="metadataLabelPrefix"     value="${metadata.label-prefix}"/>
        <property name="metadataCase"            value="${metadata.case}"/>
        <property name="wireProtocolVersion"     value="${wire.protocol-version}"/>
        <property name="walEnabled"              value="${wal.enabled}"/>
        <property name="walPath"                 value="${wal.path}"/>
        <property name="walMaxSizeBytes"         value="${wal.max-size-bytes}"/>
        <property name="walSegmentSizeBytes"     value="${wal.segment-size-bytes}"/>
        <property name="walFsync"                value="${wal.fsync}"/>
        <property name="walOverflow"             value="${wal.overflow}"/>
    </bean>

    <!--
        Operator-supplied custom HTTP headers — prefix-scanned namespace
        http.headers.<name> = <value>. Sibling to the scalar config bean
        above; out of the BlueprintWiringTest 1:1 setter-binding contract by
        design, because the cardinality of the namespace is operator-driven.

        The bean filters the full property dictionary at the PID by the
        http.headers. prefix, validates, and exposes an immutable
        Map<String,String> via headers().

        Delivery is via <cm:cm-properties>, NOT <cm:managed-properties> and
        not a ManagedService registration. Both alternatives were tried
        against the e2e `headers` gate and both left the plugin sending
        requests with no operator headers:

          - update-strategy="component-managed" invokes the update-method on
            a configuration CHANGE only, so a plugin starting with
            http.headers.* already in the .cfg received nothing.
          - a ManagedService registration is delivered by Configuration
            Admin only AFTER the service is registered, which Blueprint does
            after it has already run init-method="start" on the storage bean
            below — the clients are built from an empty header set and the
            late update never reaches them.

        <cm:cm-properties> is an injectable dependency: Blueprint resolves
        the whole PID dictionary BEFORE instantiating the beans that consume
        it, so the header set is populated by the time start() constructs
        the HTTP clients. That ordering is the entire point.
    -->
    <cm:cm-properties id="pluginProperties"
                      persistent-id="org.opennms.plugins.tss.prometheusremotewriter"
                      update="true"/>

    <bean id="httpHeadersConfig"
          class="org.opennms.plugins.prometheus.remotewriter.config.HttpHeadersConfig"
          init-method="init">
        <argument ref="pluginProperties"/>
    </bean>

    <!--
        The TimeSeriesStorage service. OpenNMS discovers it through the
        integration-api service registry and uses it as the active TSS when
        org.opennms.timeseries.strategy=integration.
    -->
    <bean id="prometheusRemoteWriterStorage"
          class="org.opennms.plugins.prometheus.remotewriter.PrometheusRemoteWriterStorage"
          init-method="start"
          destroy-method="stop">
        <argument ref="config"/>
        <argument ref="httpHeadersConfig"/>
    </bean>

    <!--
        TWO registrations of the same bean, deliberately separate:

        1. The OIA interface with registration.export=true — what OpenNMS
           core's TSS discovery consumes. MUST stay a single-objectClass
           registration: the export bridge resolves every objectClass on
           an exported service, and a class it cannot load (our concrete
           class is not visible to core) makes core skip the service
           entirely — observed as "plugin active, zero samples written".

        2. The concrete class WITHOUT registration.export — an ordinary
           container-wide OSGi service, just never forwarded to the
           OpenNMS service registry by the export bridge; the shell
           command's
           @Reference(PrometheusRemoteWriterStorage) resolves uniquely
           even when other TSS plugins are installed (no other plugin
           can register under this class) and has access to getMetrics().
           A stale duplicate KAR would create a second registration of
           this class — prevented at the source by `make kar` deleting
           stale KARs from the mounted deploy dir.
    -->
    <service ref="prometheusRemoteWriterStorage"
             interface="org.opennms.integration.api.v1.timeseries.TimeSeriesStorage">
        <service-properties>
            <entry key="registration.export" value="true"/>
        </service-properties>
    </service>

    <service ref="prometheusRemoteWriterStorage"
             interface="org.opennms.plugins.prometheus.remotewriter.PrometheusRemoteWriterStorage"/>

    <!--
        The opennms:prometheus-writer-stats shell command is NOT registered
        here: Karaf 4's CommandExtender ignores blueprint-published Action
        services. Registration happens via the Karaf-Commands manifest
        header (plugin/pom.xml) plus @Service/@Reference on StatsCommand
        itself (#113).
    -->

</blueprint>
